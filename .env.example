# Required.
TELEGRAM_TOKEN=YOUR-TELEGRAM-BOT-TOKEN-HERE

# How often to crawl the Steam news API, in seconds.
CS2_UPDATE_CHECK_INTERVAL=900

# Spam protection.
CHAT_SPAM_INTERVAL_MS=750
CHAT_BAN_TIMEOUT_SECONDS=600
CHAT_MAX_STRIKES=3
CHAT_STRIKE_RECOVERY_MINUTES=60

# Storage. Both default to database/sqlite.db when unset.
# CHAT_DB_FILEPATH=/app/database/sqlite.db
# POST_DB_FILEPATH=/app/database/sqlite.db

# Backups. Defaults to backups/backup.db when unset.
# CHAT_DB_BACKUP_FILEPATH=/app/backups/backup.db
CHAT_DB_BACKUP_INTERVAL=86400
CHAT_DB_BACKUP_COUNT=5

# Liveness file read by the container HEALTHCHECK.
# HEARTBEAT_FILEPATH=/app/bot.heartbeat

# One-off migration from the pre-sqlite JSON snapshots.
# IMPORT_CHATS_FROM_JSON=/app/chats.json
# IMPORT_POSTS_FROM_JSON=/app/posts.json
